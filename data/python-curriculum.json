            },
            {
              "category": "with语句",
              "details": "确保进入时调用__enter__，离开时（含异常）调用__exit__。常用于文件锁、资源释放、事务等"
            },
            {
              "category": "contextlib模块",
              "details": "@contextmanager通过生成器快速编写上下文管理器"
            }
          ]
        }
      ]
    },
