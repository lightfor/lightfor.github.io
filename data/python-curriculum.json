            },
            {
              "category": "抛出异常",
              "details": "raise SomeError(\"msg\")，raise不带参数可重新抛出当前异常"
            },
            {
              "category": "异常层级",
              "details": "BaseException→Exception→具体异常。自定义异常继承自Exception"
            }
          ]
        }
      ]
    },
    {
