      "emoji": "📁",
      "semesters": [
        {
          "title": "模块化编程",
          "topics": [
            {
              "category": "模块",
              "details": "一个.py文件就是一个模块"
            },
            {
              "category": "导入方式",
              "details": "import module、from module import name、from module import *（不推荐）"
            },
            {
              "category": "包",
              "details": "含__init__.py的目录（Python3.3+可缺省，但建议保留）"
            },
            {
              "category": "相对导入",
              "details": ".module在同包中使用"
            },
            {
              "category": "主程序判断",
              "details": "if __name__ == \"__main__\": 在直接运行该文件时执行"
            },
            {
              "category": "命名空间",
              "details": "每个模块有独立全局符号表"
            }
          ]
        }
      ]
    },
